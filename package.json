{
  "name": "riichi-manager",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Um app feito para ajudar jogadores e clubes de Riichi Mahjong a calcular mãos, organizar partidas e testar ideias de torneio, levando Riichi Mahjong para todos.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . && npm run -s i18n:check",
    "i18n:check": "tsx scripts/checar-traducoes.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:i18n && npm run test:guia && npm run test:tema && npm run test:notacao && npm run test:jogadores && npm run test:config-mesa && npm run test:partida && npm run test:ranking && npm run test:furiten && npm run test:batida && npm run test:clube && npm run test:regras-registro && npm run test:torneio && npm run test:formatos && npm run test:exportacao && npm run test:backup && npm run test:armazenamento && npm run test:sanma && npm run test:yakus-locais && npm run test:expressao-pontos && npm run test:filtros-lista",
    "test:filtros-lista": "tsx scripts/verificar-filtros-lista.ts",
    "test:expressao-pontos": "tsx scripts/verificar-expressao-pontos.ts",
    "test:yakus-locais": "tsx scripts/verificar-yakus-locais.ts",
    "test:i18n": "tsx scripts/verificar-traducoes.ts",
    "test:guia": "tsx scripts/verificar-guia.ts",
    "test:tema": "tsx scripts/verificar-tema.ts",
    "test:notacao": "tsx scripts/verificar-notacao.ts",
    "test:jogadores": "tsx scripts/verificar-jogadores.ts",
    "test:config-mesa": "tsx scripts/verificar-config-mesa.ts",
    "test:partida": "tsx scripts/verificar-partida.ts",
    "test:ranking": "tsx scripts/verificar-ranking.ts",
    "test:furiten": "tsx scripts/verificar-furiten.ts",
    "test:batida": "tsx scripts/verificar-batida.ts",
    "test:clube": "tsx scripts/verificar-clube.ts",
    "test:regras-registro": "tsx scripts/verificar-regras-registro.ts",
    "test:torneio": "tsx scripts/verificar-torneio.ts",
    "test:formatos": "tsx scripts/verificar-formatos.ts",
    "test:exportacao": "tsx scripts/verificar-exportacao.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "predeploy": "npm run build && tsx scripts/debug-deploy.ts",
    "debug-deploy": "tsx scripts/debug-deploy.ts",
    "deploy": "npx gh-pages -d dist",
    "test:backup": "tsx scripts/verificar-backup.ts",
    "test:armazenamento": "tsx scripts/verificar-armazenamento.ts",
    "test:sanma": "tsx scripts/verificar-sanma.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "d3-force": "^3.0.1",
    "dexie": "^4.4.7",
    "immer": "^10.0.0",
    "jsqr": "^1.4.0",
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "riichi": "github:1Computer1/riichi",
    "use-immer": "^0.9.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^25.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "fake-indexeddb": "^6.2.8",
    "gh-pages": "^6.3.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.11"
  },
  "homepage": "https://lucaslamar.github.io/Riichi-Manager/"
}
